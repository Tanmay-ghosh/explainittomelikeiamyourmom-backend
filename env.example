# Copy to .env for local runs. On Cloud Run, set these with --set-env-vars (the API key goes in Secret Manager).

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models (optional). The Writer only rephrases, so a smaller, cheaper model is the default.
EXPERT_MODEL=claude-sonnet-5-5
WRITER_MODEL=claude-haiku-5-5
TRANSCRIBE_MODEL=claude-sonnet-5-5

# Mixpanel (optional; analytics stay off until MIXPANEL_TOKEN is set)
MIXPANEL_TOKEN=your-mixpanel-project-token
# api.mixpanel.com (US), api-eu.mixpanel.com (EU) or api-in.mixpanel.com (India)
MIXPANEL_API_HOST=api.mixpanel.com

# Which websites may call this API. Lovable and localhost are allowed by default.
# Add your own domain once you connect it, e.g. https://www.yoursite.com
ALLOWED_ORIGINS=

# Safety limits
DAILY_EXPLANATION_LIMIT=50
PER_IP_HOURLY_LIMIT=10
MAX_FILES=5
MAX_FILE_MB=10

# Optional: Claude prices in US$ per million tokens, to estimate cost per explanation.
# Copy these from Anthropic's pricing page for the model you use.
INPUT_PRICE_PER_MTOK=
OUTPUT_PRICE_PER_MTOK=
